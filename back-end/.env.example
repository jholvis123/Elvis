# ============================================
# Portfolio Backend - Environment Variables
# ============================================
# Copy this file to .env and configure your values
# ============================================

# App Configuration
APP_NAME=Portfolio Backend
APP_VERSION=1.0.0
DEBUG=True

# Public self-registration via POST /api/v1/auth/register
# Default false in code — keep false in production. Use create_admin.py for admin.
ALLOW_PUBLIC_REGISTER=false

# API
API_V1_PREFIX=/api/v1

# CORS - Comma-separated origins
CORS_ORIGINS=["http://localhost:4200","https://jholvis123.github.io"]

# Database — pick one (SQLAlchemy URL-driven)
# Local MySQL (XAMPP): mysql+pymysql://root:@localhost:3306/portfolio_db
DATABASE_URL=mysql+pymysql://root:@localhost:3306/portfolio_db
# Render Postgres example (set in dashboard; do not commit real credentials):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Cookies (Render HTTPS)
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# Cross-origin admin from GitHub Pages stays limited with lax; do not set none until FE ready.

# JWT Security
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=[".md",".pdf",".png",".jpg",".pcap"]

# ============================================
# Admin User (para create_admin.py)
# ============================================
# Configura estas variables antes de ejecutar el script
ADMIN_EMAIL=admin@tudominio.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CambiaEstaContraseñaSegura123!
